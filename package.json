{
  "name": "dercoolezoo",
  "version": "0.4.7",
  "description": "A kind, isometric zoo-building game for children aged eight and up.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "verify": "./localPipeline.sh",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelpetrick/DerCooleZoo.git"
  },
  "keywords": [],
  "author": "Marcel Petrick <mail@marcelpetrick.it>",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bugs": {
    "url": "https://github.com/marcelpetrick/DerCooleZoo/issues"
  },
  "homepage": "https://github.com/marcelpetrick/DerCooleZoo#readme",
  "dependencies": {
    "@babylonjs/core": "9.32.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "private": true
}
